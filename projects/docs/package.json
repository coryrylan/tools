{
  "name": "docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "eleventy --serve --port=8083",
    "build": "wireit",
    "lint": "wireit",
    "lint:fix": "eslint -c ./eslint.config.js --fix",
    "ci": "wireit",
    "clean": "rm -rf dist .eslintcache"
  },
  "dependencies": {
    "@nvidia-elements/code": "2.0.4",
    "@nvidia-elements/core": "2.6.0",
    "@nvidia-elements/styles": "2.1.3",
    "@nvidia-elements/themes": "2.0.1"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@11ty/eleventy-plugin-vite": "8.0.0",
    "@coryrylan/tools": "workspace:*",
    "@nvidia-elements/lint": "2.4.0",
    "eslint": "10.9.1",
    "markdown-it": "15.0.1",
    "wireit": "0.14.13"
  },
  "wireit": {
    "build": {
      "command": "eleventy",
      "dependencies": [
        "../tools:test",
        "../tools:lint"
      ],
      "files": [
        "src/**",
        "eleventy.config.js",
        "rule-docs.js",
        "surface-docs.js",
        "doc-utils.js",
        "package.json",
        "../tools/src/*/docs/**",
        "../tools/package.json"
      ],
      "output": [
        "dist/**"
      ],
      "env": {
        "PAGES_BASE_URL": {
          "external": true
        }
      }
    },
    "lint": {
      "command": "eslint -c ./eslint.config.js --color --cache --cache-location .eslintcache/",
      "files": [
        "src/**",
        "eleventy.config.js",
        "rule-docs.js",
        "surface-docs.js",
        "doc-utils.js",
        "eslint.config.js",
        "package.json"
      ],
      "output": []
    },
    "ci": {
      "dependencies": [
        "lint",
        "build"
      ]
    }
  }
}
