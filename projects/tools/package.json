{
  "name": "@coryrylan/tools",
  "version": "1.1.1",
  "license": "MIT",
  "type": "module",
  "description": "Shared ESLint, Prettier, Stylelint, Vale, Vite, and Vitest configs, custom lint rules, and pi coding-agent extensions - for keeping codebases maintainable when coding agents are the primary contributors.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coryrylan/tools.git",
    "directory": "projects/tools"
  },
  "author": "Cory Rylan (https://coryrylan.com)",
  "bugs": {
    "url": "https://github.com/coryrylan/tools/issues"
  },
  "homepage": "https://github.com/coryrylan/tools/tree/main/projects/tools#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "exports": {
    "./eslint": {
      "types": "./dist/eslint/index.d.ts",
      "default": "./dist/eslint/index.js"
    },
    "./prettier": {
      "types": "./dist/prettier/index.d.ts",
      "default": "./dist/prettier/index.js"
    },
    "./stylelint": {
      "types": "./dist/stylelint/index.d.ts",
      "default": "./dist/stylelint/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./vite/plugins/write-if-changed": {
      "types": "./dist/vite/plugins/write-if-changed.d.ts",
      "default": "./dist/vite/plugins/write-if-changed.js"
    },
    "./vite/plugins/dts": {
      "types": "./dist/vite/plugins/dts.d.ts",
      "default": "./dist/vite/plugins/dts.js"
    },
    "./vitest": {
      "types": "./dist/vitest/index.d.ts",
      "default": "./dist/vitest/index.js"
    },
    "./vitest/browser": {
      "types": "./dist/vitest/browser.d.ts",
      "default": "./dist/vitest/browser.js"
    },
    "./pi/greeting": {
      "types": "./dist/pi/greeting/index.d.ts",
      "default": "./dist/pi/greeting/index.js"
    },
    "./pi/audio-summary": {
      "types": "./dist/pi/audio-summary/index.d.ts",
      "default": "./dist/pi/audio-summary/index.js"
    },
    "./pi/hooks": {
      "types": "./dist/pi/hooks/index.d.ts",
      "default": "./dist/pi/hooks/index.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./dist/pi/greeting/index.js",
      "./dist/pi/audio-summary/index.js",
      "./dist/pi/hooks/index.js"
    ]
  },
  "scripts": {
    "ci": "wireit",
    "typecheck": "wireit",
    "build": "wireit",
    "test": "wireit",
    "lint": "wireit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@eslint/js": ">=9",
    "@eslint/json": ">=0.13.0",
    "@html-eslint/eslint-plugin": ">=0.61.0",
    "@html-eslint/parser": ">=0.61.0",
    "@vitest/browser-playwright": ">=4.0.0",
    "@vitest/coverage-istanbul": ">=4.0.0",
    "eslint": ">=9",
    "eslint-plugin-jsdoc": ">=60.0.0",
    "playwright": ">=1.50.0",
    "prettier": ">=3.0.0",
    "stylelint": ">=17.0.0",
    "stylelint-config-standard": ">=40.0.0",
    "typebox": "*",
    "typescript": ">=5.5.0 <6.1.0",
    "typescript-eslint": ">=8.40.0",
    "vite": ">=8.0.0",
    "vitest": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@vitest/browser-playwright": {
      "optional": true
    },
    "@vitest/coverage-istanbul": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    },
    "stylelint-config-standard": {
      "optional": true
    },
    "typebox": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.0.1",
    "@html-eslint/eslint-plugin": "0.65.0",
    "@html-eslint/parser": "0.65.0",
    "@types/estree": "1.0.9",
    "@types/node": "26.4.0",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-istanbul": "4.1.11",
    "eslint": "10.9.1",
    "eslint-plugin-jsdoc": "64.2.1",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typebox": "1.3.22",
    "typescript": "7.0.2",
    "typescript-eslint": "8.68.0",
    "typescript-go": "npm:typescript@7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wireit": "0.14.13"
  },
  "wireit": {
    "ci": {
      "dependencies": [
        "typecheck",
        "build",
        "test",
        "lint"
      ]
    },
    "typecheck": {
      "command": "node ./node_modules/typescript-go/bin/tsc -p tsconfig.json --noEmit && node ./node_modules/typescript-go/bin/tsc -p tsconfig.node.json --noEmit",
      "files": [
        "src/**/*.ts",
        "tsconfig.json",
        "tsconfig.node.json",
        "vite.config.ts",
        "vitest.config.ts"
      ],
      "output": []
    },
    "build": {
      "command": "vite build && node ./node_modules/typescript-go/bin/tsc -p tsconfig.build.json",
      "dependencies": [
        "typecheck"
      ],
      "files": [
        "src/**/*.ts",
        "src/vale/vale.ini",
        "src/vale/styles/config/**",
        "vite.config.ts",
        "tsconfig.json",
        "tsconfig.build.json"
      ],
      "output": [
        "dist/**"
      ]
    },
    "test": {
      "command": "vitest run",
      "dependencies": [
        "typecheck"
      ],
      "files": [
        "src/**/*.ts",
        "src/vale/vale.ini",
        "src/vale/styles/config/**",
        "vitest.config.ts"
      ],
      "output": []
    },
    "lint": {
      "command": "eslint .",
      "dependencies": [
        "build"
      ],
      "files": [
        "src/**/*.ts",
        "../../eslint.config.js"
      ],
      "output": []
    }
  }
}
